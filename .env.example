# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# --- Servidor ---
PORT=3000
# URL pública HTTPS onde a Iris está hospedada (usada no login do Mercado Livre)
PUBLIC_URL=https://iris.seudominio.com.br
# Senha do painel /admin (usuário: admin)
ADMIN_PASSWORD=troque-esta-senha
# Caminho do banco SQLite
DB_PATH=./data/iris.db
# Arquivo com as informações do seu negócio (copie de data/negocio.exemplo.md)
KNOWLEDGE_FILE=./data/negocio.md

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Limite de chamadas ao Claude por dia (trava de custo)
MAX_CLAUDE_CALLS_PER_DAY=300

# --- Modo de envio ---
# suggest = Iris escreve e você aprova no painel | auto = envia sozinha (casos sensíveis sempre vão pro painel)
WA_MODE=suggest
ML_MODE=suggest
# Abaixo desta confiança (0 a 1), a resposta vai para o painel mesmo no modo auto
MIN_CONFIDENCE=0.75

# --- WhatsApp Cloud API (Meta) ---
WA_ENABLED=false
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Texto que você inventa e cola também no painel da Meta ao configurar o webhook
WA_VERIFY_TOKEN=
# App Secret do app na Meta (valida que o webhook veio mesmo da Meta)
WA_APP_SECRET=
WA_GRAPH_VERSION=v21.0

# --- Mercado Livre ---
ML_ENABLED=false
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Opcional: ID do vendedor (preenchido automaticamente após o login em /auth/ml)
ML_SELLER_ID=
