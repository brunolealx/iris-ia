# ===== Iris Worker =====
PORT=8080
# URL pública HTTPS do worker (ex.: https://api.iris.seudominio.com.br)
PUBLIC_URL=

# --- Supabase (Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
# service_role: NUNCA coloque no painel/navegador
SUPABASE_SERVICE_ROLE_KEY=

# Mesma chave do painel (32 bytes base64) para abrir os segredos das integrações
ENCRYPTION_KEY=

# --- Claude (a conta é SUA; o custo entra no preço do plano) ---
ANTHROPIC_API_KEY=

# --- Meta / WhatsApp Cloud API (um app da Meta para toda a plataforma) ---
META_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0

# --- Mercado Livre (um app para toda a plataforma) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- Google (planilhas no Drive do cliente) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mercado Pago (assinaturas) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Quantos jobs processar em paralelo
CONCURRENCY=3
