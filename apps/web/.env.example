# ===== Iris Painel (Next.js) =====
NEXT_PUBLIC_APP_URL=https://app.iris.seudominio.com.br

# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (rotas e server actions). NUNCA com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Mesma chave do worker (32 bytes base64)
ENCRYPTION_KEY=

# URL pública do worker (mostrada na tela de integrações)
NEXT_PUBLIC_WORKER_URL=https://api.iris.seudominio.com.br

# Meta — Cadastro Incorporado do WhatsApp
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
META_APP_SECRET=
WA_GRAPH_VERSION=v21.0

# Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Google (Drive + Sheets, escopo drive.file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago (assinaturas)
MP_ACCESS_TOKEN=
